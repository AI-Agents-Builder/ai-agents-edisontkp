# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Product Price IDs
# Create products and prices in Stripe Dashboard: https://dashboard.stripe.com/products
NEXT_PUBLIC_STRIPE_PRICE_LITE=price_lite_id_here
NEXT_PUBLIC_STRIPE_PRICE_PRO_STARTER=price_pro_starter_id_here
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_AUTO=price_business_auto_id_here
NEXT_PUBLIC_STRIPE_PRICE_SALES_CS=price_sales_cs_id_here
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_enterprise_id_here
NEXT_PUBLIC_STRIPE_PRICE_PILOT=price_pilot_id_here

# Stripe Webhook Secret (for handling payment events)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Calendly Configuration
# Your Calendly scheduling URL
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/edisontkp/discovery-call

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://aiagent.edisontkp.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@edisontkp.com
